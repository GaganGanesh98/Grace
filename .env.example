# Backend environment (Phase 2.3+)
# Copy this file to apps/backend/.env (recommended, gitignored) and/or repo-root .env / .env.dev.
# Settings merges, in order: .env, .env.dev, apps/backend/.env (later overrides earlier).
# See docs/auth-setup.md for Google OAuth redirect URIs and troubleshooting.

# Database
DATABASE_URL=postgresql+asyncpg://axiom:axiom_dev_only@localhost:5433/axiom
DATABASE_ECHO=false

# Redis
REDIS_URL=redis://localhost:6380/0

# Security
SECRET_KEY=REPLACE_WITH_openssl_rand_hex_64
JWT_SECRET=REPLACE_WITH_openssl_rand_hex_32
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30
JWT_ALGORITHM=HS256
ENCRYPTION_KEY=REPLACE_WITH_openssl_rand_hex_32

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/callback/google

# App
ENVIRONMENT=development
APP_URL=http://localhost:3000
API_URL=http://localhost:8000
BACKEND_CORS_ORIGINS=["http://localhost:3000"]
LOG_LEVEL=INFO
