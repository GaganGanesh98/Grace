# Server-side URL for FastAPI when Next.js BFF proxies requests (no trailing slash).
# In production, point at your public API host (e.g. https://api.axiom.dev).
API_URL=http://localhost:8000

# Optional: browser-visible API base if any client-side code calls the backend directly.
# Most dashboard calls use same-origin /api/* routes; prefer API_URL for BFF.
# NEXT_PUBLIC_API_URL=http://localhost:8000

# Session cookie options (Next.js Route Handlers — setAuthCookies / clearAuthCookies).
# Production: set AXIOM_COOKIE_SECURE=true; use AXIOM_COOKIE_DOMAIN for shared parent domain if needed.
# For cross-site frontends/APIs, SameSite=None requires Secure=true.
AXIOM_COOKIE_SECURE=false
AXIOM_COOKIE_SAMESITE=lax
AXIOM_COOKIE_DOMAIN=
