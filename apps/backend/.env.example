# Copy to apps/backend/.env (gitignored). Merged with repo-root .env / .env.dev — see axiom.config.Settings.
#
# Phase 8.2 renamed these to GRACE_*. The old AXIOM_* spelling still works, and
# GRACE_* wins when both are set; the API logs any AXIOM_* variable still in use
# at startup. See ADR-029 and ADR-030 in docs/decisions.md.

# --- Core ---
GRACE_ENVIRONMENT=development
GRACE_LOG_LEVEL=INFO

# Public URLs (production: use HTTPS hosts)
GRACE_FRONTEND_URL=http://localhost:3000
GRACE_API_URL=http://localhost:8000
GRACE_VERIFY_BASE_URL=http://localhost:8000

# CORS: JSON array OR comma-separated list
# GRACE_CORS_ORIGINS=https://app.example.com,https://www.example.com
GRACE_CORS_ORIGINS=["http://localhost:3000"]

# Documented for ops / parity with Next cookie settings (session cookies are set by the Next.js BFF).
GRACE_COOKIE_SECURE=false
GRACE_COOKIE_SAMESITE=lax
GRACE_COOKIE_DOMAIN=

# --- Data stores ---
GRACE_DATABASE_URL=postgresql+asyncpg://axiom:axiom_dev_only@localhost:5433/axiom
GRACE_DATABASE_ECHO=false
GRACE_REDIS_URL=redis://localhost:6380/0

# --- Secrets (generate with openssl rand -hex 32 / 64) ---
GRACE_SECRET_KEY=REPLACE_WITH_openssl_rand_hex_64
GRACE_JWT_SECRET=REPLACE_WITH_openssl_rand_hex_32
GRACE_JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
GRACE_JWT_REFRESH_TOKEN_EXPIRE_DAYS=30
GRACE_JWT_ALGORITHM=HS256
GRACE_ENCRYPTION_KEY=REPLACE_WITH_openssl_rand_hex_32

# --- Google OAuth (backend validates tokens / builds authorize URL) ---
GRACE_GOOGLE_CLIENT_ID=
GRACE_GOOGLE_CLIENT_SECRET=
# Must match an authorized redirect URI in Google Cloud Console (usually the Next.js callback URL).
GRACE_GOOGLE_REDIRECT_URI=http://localhost:3000/auth/callback/google

# --- Phase 2 governance signing + evidence (optional in dev; required in production) ---
# Auto-generated into this file on first dev run. Losing the evidence key makes
# historical receipt evidence permanently undecryptable — see
# docs/runbooks/key-rotation.md before touching these.
# GRACE_ED25519_PRIVATE_PEM=
# GRACE_ED25519_PUBLIC_PEM=
# GRACE_ML_DSA_PRIVATE_B64=
# GRACE_ML_DSA_PUBLIC_B64=
# GRACE_EVIDENCE_KEY_B64=

# --- Phase 8.2 vault key-encryption key (GRACE_* only; no AXIOM_* spelling) ---
# Unset in dev: derived from the evidence key by HKDF, so nothing to configure.
# REQUIRED in production — an independent key is what makes the separation real.
# Generate with: openssl rand -base64 32
# GRACE_VAULT_KEK_B64=
# Optional: an explicit id (e.g. a KMS key name) instead of a fingerprint.
# GRACE_VAULT_KEK_ID=
# Comma-separated retired KEKs, readable until their row count reaches zero.
# GRACE_VAULT_KEK_PREVIOUS_B64=

# --- Agent worker → governance gateway (local dev) ---
# On ./axiom dev, a project API key is auto-minted into this line (no manual paste).
# Set GRACE_WORKER_AUTOMINT=0 to disable auto-mint and manage the key yourself.
# GRACE_WORKER_GATEWAY_API_KEY=
# GRACE_WORKER_AUTOMINT=

# --- n8n escalation callback (Grace -> n8n -> Grace) ---
# GRACE_ESCALATION_ENABLED=1
# GRACE_N8N_ESCALATION_WEBHOOK_URL=http://localhost:5678/webhook/axiom-escalation
# GRACE_N8N_CALLBACK_SECRET=dev_escalation_secret_change_me

# --- Reusable governed-action webhook (n8n -> Grace), Phase 9.1 ---
# Deliberately a DIFFERENT secret from the callback above: that one only resolves
# a receipt Grace already created, this one can originate a governed action for
# any project. Unset means POST /webhooks/n8n/govern-action returns 503.
# GRACE_N8N_ACTION_SECRET=dev_action_secret_change_me
# How long an n8n execution id stays claimed so a retry returns the original
# receipt instead of governing the same action twice.
# GRACE_N8N_ACTION_IDEMPOTENCY_TTL_SECONDS=86400

# --- Other ---
GRACE_PREFLIGHT_CACHE_TTL_SECONDS=3600
