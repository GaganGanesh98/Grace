# Copy to apps/backend/.env (gitignored). Merged with repo-root .env / .env.dev — see axiom.config.Settings.

# --- Core ---
ENVIRONMENT=development
LOG_LEVEL=INFO

# Public URLs (production: use HTTPS hosts)
# Aliases: AXIOM_FRONTEND_URL, AXIOM_API_URL also accepted.
APP_URL=http://localhost:3000
API_URL=http://localhost:8000
AXIOM_VERIFY_BASE_URL=http://localhost:8000

# CORS: JSON array OR comma-separated list
# AXIOM_CORS_ORIGINS=https://app.example.com,https://www.example.com
BACKEND_CORS_ORIGINS=["http://localhost:3000"]

# Documented for ops / parity with Next cookie settings (session cookies are set by the Next.js BFF).
AXIOM_COOKIE_SECURE=false
AXIOM_COOKIE_SAMESITE=lax
AXIOM_COOKIE_DOMAIN=

# --- Data stores ---
DATABASE_URL=postgresql+asyncpg://axiom:axiom_dev_only@localhost:5433/axiom
DATABASE_ECHO=false
REDIS_URL=redis://localhost:6380/0

# --- Secrets (generate with openssl rand -hex 32 / 64) ---
SECRET_KEY=REPLACE_WITH_openssl_rand_hex_64
JWT_SECRET=REPLACE_WITH_openssl_rand_hex_32
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30
JWT_ALGORITHM=HS256
ENCRYPTION_KEY=REPLACE_WITH_openssl_rand_hex_32

# --- Google OAuth (backend validates tokens / builds authorize URL) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match an authorized redirect URI in Google Cloud Console (usually the Next.js callback URL).
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/callback/google

# --- Phase 2 governance signing (optional in dev; required in production) ---
# AXIOM_ED25519_PRIVATE_PEM=
# AXIOM_ED25519_PUBLIC_PEM=
# AXIOM_ML_DSA_PRIVATE_B64=
# AXIOM_ML_DSA_PUBLIC_B64=
# AXIOM_EVIDENCE_KEY_B64=

# --- Agent worker → governance gateway (local dev) ---
# On ./axiom dev, a project API key is auto-minted into this line (no manual paste).
# Set AXIOM_WORKER_AUTOMINT=0 to disable auto-mint and manage the key yourself.
# AXIOM_WORKER_GATEWAY_API_KEY=
# AXIOM_WORKER_AUTOMINT=

# --- Other ---
PREFLIGHT_CACHE_TTL_SECONDS=3600
